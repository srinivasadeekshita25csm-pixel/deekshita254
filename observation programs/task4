import java.util.Scanner;

class Student {
    int rollNumber;
    String studentName;
    int[] marks;

    // Constructor to initialize student details
    Student(int rollNumber, String studentName, int[] marks) {
        this.rollNumber = rollNumber;
        this.studentName = studentName;
        this.marks = marks;
    }

    // Calculate total marks
    int calculateTotal() {
        int total = 0;

        for (int mark : marks) {
            total += mark;
        }

        return total;
    }

    // Calculate average marks
    double calculateAverage() {
        return (double) calculateTotal() / marks.length;
    }

    // Find highest mark
    int findHighest() {
        int highest = marks[0];

        for (int mark : marks) {
            highest = Math.max(highest, mark);
        }

        return highest;
    }

    // Find lowest mark
    int findLowest() {
        int lowest = marks[0];

        for (int mark : marks) {
            lowest = Math.min(lowest, mark);
        }

        return lowest;
    }

    // Calculate percentage
    double calculatePercentage() {
        double percentage = (double) calculateTotal() / 500 * 100;

        // Round percentage to two decimal places
        return Math.round(percentage * 100.0) / 100.0;
    }

    // Determine grade
    String determineGrade(double percentage) {
        if (percentage >= 90)
            return "A+";
        else if (percentage >= 80)
            return "A";
        else if (percentage >= 70)
            return "B";
        else if (percentage >= 60)
            return "C";
        else if (percentage >= 50)
            return "D";
        else
            return "F";
    }

    // Determine pass or fail
    String getResult(double percentage) {
        if (percentage >= 50)
            return "PASS";
        else
            return "FAIL";
    }

    // Performance remark
    String getRemark(String grade) {
        switch (grade) {
            case "A+":
                return "Outstanding Performance";
            case "A":
                return "Excellent Performance";
            case "B":
                return "Very Good Performance";
            case "C":
                return "Good Performance";
            case "D":
                return "Satisfactory Performance";
            default:
                return "Needs Improvement";
        }
    }

    // Display complete performance report
    void displayDetails() {

        // String operations
        String formattedName = studentName.trim().toUpperCase();
        int nameLength = formattedName.length();

        double percentage = calculatePercentage();
        String grade = determineGrade(percentage);

        System.out.println("\n==========================================");
        System.out.println("       STUDENT PERFORMANCE REPORT");
        System.out.println("==========================================");

        System.out.println("Roll Number       : " + rollNumber);
        System.out.println("Student Name      : " + formattedName);
        System.out.println("Name Length       : " + nameLength);

        System.out.print("Subject Marks     : ");
        for (int mark : marks) {
            System.out.print(mark + " ");
        }

        System.out.println("\nTotal Marks       : " + calculateTotal());
        System.out.printf("Average Marks     : %.2f%n", calculateAverage());
        System.out.println("Highest Mark      : " + findHighest());
        System.out.println("Lowest Mark       : " + findLowest());
        System.out.println("Percentage        : " + percentage + "%");
        System.out.println("Grade             : " + grade);
        System.out.println("Result            : " + getResult(percentage));
        System.out.println("Performance Remark: " + getRemark(grade));

        System.out.println("==========================================");
    }
}

public class StudentPerformance {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("==========================================");
        System.out.println("   STUDENT PERFORMANCE ANALYSIS SYSTEM");
        System.out.println("==========================================");

        System.out.print("Enter Roll Number: ");
        int rollNumber = sc.nextInt();

        sc.nextLine(); // Consume newline

        System.out.print("Enter Student Name: ");
        String studentName = sc.nextLine();

        int[] marks = new int[5];

        System.out.println("Enter marks for 5 subjects:");

        for (int i = 0; i < 5; i++) {
            System.out.print("Subject " + (i + 1) + ": ");
            marks[i] = sc.nextInt();
        }

        // Create Student object
        Student student = new Student(rollNumber, studentName, marks);

        // Display performance report
        student.displayDetails();

        sc.close();
    }
}
