package myprogs;


import java.util.Scanner;

// Interface
interface PaymentService {
    void pay(String upiId, double amount)
            throws InvalidUPIException, InvalidAmountException,
            InsufficientBalanceException;

    void checkBalance();
}

// Custom Exception 1
class InsufficientBalanceException extends Exception {
    InsufficientBalanceException(String message) {
        super(message);
    }
}

// Custom Exception 2
class InvalidUPIException extends Exception {
    InvalidUPIException(String message) {
        super(message);
    }
}

// Custom Exception 3
class InvalidAmountException extends Exception {
    InvalidAmountException(String message) {
        super(message);
    }
}

// Wallet Class
class Wallet {

    private String userName;
    private String mobileNumber;
    private String upiId;
    private double balance;

    // Constructor
    Wallet(String userName, String mobileNumber,
           String upiId, double balance) {

        this.userName = userName;
        this.mobileNumber = mobileNumber;
        this.upiId = upiId;
        this.balance = balance;
    }

    // Add money to wallet
    void addMoney(double amount) {

        if (amount > 0) {
            balance = balance + amount;
            System.out.println("Money added successfully: Rs." + amount);
        } else {
            System.out.println("Invalid amount.");
        }
    }

    // Get wallet balance
    double getBalance() {
        return balance;
    }

    // Deduct payment amount
    void deductMoney(double amount) {
        balance = balance - amount;
    }

    // Display wallet details
    void displayWalletDetails() {

        System.out.println("\n----- Wallet Details -----");
        System.out.println("User Name     : " + userName);
        System.out.println("Mobile Number : " + mobileNumber);
        System.out.println("UPI ID        : " + upiId);
        System.out.println("Balance       : Rs." + balance);
    }
}

// UPI Payment Class
class UPIPayment implements PaymentService {

    private Wallet wallet;

    // Constructor
    UPIPayment(Wallet wallet) {
        this.wallet = wallet;
    }

    // Pay method
    public void pay(String upiId, double amount)
            throws InvalidUPIException,
            InvalidAmountException,
            InsufficientBalanceException {

        // Validate UPI ID
        if (!upiId.contains("@")) {
            throw new InvalidUPIException(
                    "Invalid UPI ID. UPI ID must contain '@'.");
        }

        // Validate amount
        if (amount <= 0) {
            throw new InvalidAmountException(
                    "Invalid amount. Amount must be greater than zero.");
        }

        // Check balance
        if (amount > wallet.getBalance()) {
            throw new InsufficientBalanceException(
                    "Insufficient balance. Payment cannot be processed.");
        }

        // Deduct amount
        wallet.deductMoney(amount);

        System.out.println("\nPayment Successful!");
        System.out.println("Paid To      : " + upiId);
        System.out.println("Amount Paid  : Rs." + amount);
    }

    // Check balance
    public void checkBalance() {
        System.out.println("Available Balance: Rs."
                + wallet.getBalance());
    }
}

// Main Class
public class UPI {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Create wallet
        Wallet wallet = new Wallet(
                "Sai",
                "9876543210",
                "sai@upi",
                5000
        );

        // Create UPI payment object
        UPIPayment payment = new UPIPayment(wallet);

        wallet.displayWalletDetails();

        // Add money
        System.out.print("\nEnter amount to add: ");
        double addAmount = sc.nextDouble();

        wallet.addMoney(addAmount);

        // Payment details
        System.out.print("\nEnter receiver UPI ID: ");
        String receiverUPI = sc.next();

        System.out.print("Enter payment amount: ");
        double paymentAmount = sc.nextDouble();

        // Exception handling
        try {

            payment.pay(receiverUPI, paymentAmount);

        } catch (InvalidUPIException e) {

            System.out.println("Transaction Failed: "
                    + e.getMessage());

        } catch (InvalidAmountException e) {

            System.out.println("Transaction Failed: "
                    + e.getMessage());

        } catch (InsufficientBalanceException e) {

            System.out.println("Transaction Failed: "
                    + e.getMessage());

        } finally {

            System.out.println("\nTransaction processing completed.");
        }

        // Display final balance
        System.out.println("\n----- Final Balance -----");
        payment.checkBalance();

        // Display final wallet details
        wallet.displayWalletDetails();

        sc.close();
    }
}
